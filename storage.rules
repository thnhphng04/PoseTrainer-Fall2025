rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatars: mỗi user chỉ đọc/ghi được avatar của chính mình
    match /avatars/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024       // Tối đa 5MB
        && request.resource.contentType.matches('image/.*'); // Chỉ ảnh
    }

    // Community post images: user đã đăng nhập mới được upload
    match /community/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024      // Tối đa 10MB mỗi ảnh
        && request.resource.contentType.matches('image/.*');
    }

    // Mặc định: từ chối tất cả
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
