# Auto detect text files and perform LF normalization
* text=auto

# Java source files - use LF in repository
*.java text eol=lf
*.kt text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.py text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.apk binary
*.aab binary
*.jar binary
*.class binary
*.so binary
*.pyc binary

