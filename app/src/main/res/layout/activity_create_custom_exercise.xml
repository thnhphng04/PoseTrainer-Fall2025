<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="?attr/colorPrimary">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tạo bài tập mới"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Nội dung chính -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tên bài tập -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên bài tập *"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtExerciseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập tên bài tập"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="16dp" />

            <!-- Mô tả bài tập -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mô tả bài tập"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtExerciseDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mô tả cách thực hiện động tác..."
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:minHeight="100dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:layout_marginBottom="16dp" />

            <!-- Loại động tác -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loại động tác *"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerExerciseType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn loại động tác để AI biết nên tập trung vào góc nào (tay, chân, lưng, v.v.)"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="16dp" />

            <!-- Bộ phận cơ thể chính cần check -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bộ phận cơ thể chính cần check"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <CheckBox
                    android:id="@+id/cbCheckArms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tay (elbowAngle)"
                    android:textSize="14sp"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/cbCheckLegs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chân (kneeAngle)"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbCheckBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cơ thể (bodyAngle)"
                    android:textSize="14sp"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/cbCheckHips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hông (hipAngle)"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn các bộ phận cơ thể mà MediaPipe cần kiểm tra để detect động tác chính xác"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="16dp" />

            <!-- Các lỗi form phổ biến -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Các lỗi form phổ biến cần check (tùy chọn)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtCommonErrors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ví dụ: Hips sagging, Elbows flaring, Not low enough, Bent knees..."
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:minHeight="80dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhập các lỗi form phổ biến mà người dùng thường mắc phải. AI sẽ tạo feedback messages cho các lỗi này."
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="16dp" />

            <!-- Số bước/trạng thái của động tác -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số bước/trạng thái của động tác *"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtNumberOfSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập số bước (4-10, ví dụ: 6)"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:inputType="number"
                android:digits="0123456789"
                android:enabled="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:selectAllOnFocus="true"
                android:text="6"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số bước này sẽ tương ứng với số ảnh bạn cần upload. Ví dụ: 6 bước = 6 ảnh, mỗi ảnh mô tả một trạng thái của động tác."
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="16dp" />

            <!-- Hướng dẫn upload ảnh -->
            <TextView
                android:id="@+id/tvImageUploadTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload 6 ảnh mô tả các trạng thái của động tác *"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvImageUploadHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload ảnh theo thứ tự các trạng thái của động tác. Mỗi ảnh mô tả một bước trong quá trình thực hiện động tác."
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="12dp" />

            <!-- Grid hiển thị 6 ảnh -->
            <GridLayout
                android:id="@+id/gridImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="false"
                android:layout_marginBottom="16dp">

                <!-- Ảnh 1: Chuẩn bị -->
                <LinearLayout
                    android:id="@+id/layoutImage1"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#F5F5F5"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivImage1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#E0E0E0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Chuẩn bị"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Ảnh 2: Bắt đầu -->
                <LinearLayout
                    android:id="@+id/layoutImage2"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#F5F5F5"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivImage2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#E0E0E0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Bắt đầu"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Ảnh 3: Giữa -->
                <LinearLayout
                    android:id="@+id/layoutImage3"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#F5F5F5"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivImage3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#E0E0E0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Giữa"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Ảnh 4: Kết thúc -->
                <LinearLayout
                    android:id="@+id/layoutImage4"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#F5F5F5"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivImage4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#E0E0E0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. Kết thúc"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Ảnh 5: Giữa 2 (tùy chọn) -->
                <LinearLayout
                    android:id="@+id/layoutImage5"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#F5F5F5"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivImage5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#E0E0E0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5. Giữa 2 (tùy chọn)"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Ảnh 6: Quay lại (tùy chọn) -->
                <LinearLayout
                    android:id="@+id/layoutImage6"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#F5F5F5"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivImage6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#E0E0E0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6. Quay lại (tùy chọn)"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </GridLayout>

            <!-- Nút tạo bài tập -->
            <Button
                android:id="@+id/btnCreateExercise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tạo bài tập"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="16dp"
                android:layout_marginTop="16dp" />

            <!-- Thanh tiến trình -->
            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:textColor="#666666"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

