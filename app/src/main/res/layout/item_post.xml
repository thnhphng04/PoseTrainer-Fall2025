<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#ff2a3142"
    android:layout_marginBottom="8dp"
    android:padding="8dp"
    android:elevation="0dp"
    android:layout_marginHorizontal="6dp"
    android:clipToOutline="true"
    android:backgroundTint="#ff2a3142">

    <!-- Header: Avatar + Tên người đăng + thời gian + nút 3 chấm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Avatar người đăng -->
        <ImageView
            android:id="@+id/ivAuthorAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_background"
            android:contentDescription="Avatar người đăng" />

        <!-- Tên người đăng + thời gian -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên người đăng"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04/11/2025 13:27"
                android:textSize="12sp"
                android:textColor="#99ffffff" />
        </LinearLayout>

        <!-- Nút 3 chấm (More options) -->
        <ImageButton
            android:id="@+id/btn_more_options"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/round_button_bg"
            android:contentDescription="More options"
            android:padding="6dp"
            android:src="@drawable/ic_more_vert"
            app:tint="#99ffffff" />
    </LinearLayout>

    <!-- Nội dung bài viết -->
    <TextView
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nội dung bài viết ở đây"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:layout_marginTop="6dp" />

    <!-- Container cho nhiều ảnh với RecyclerView horizontal -->
    <LinearLayout
        android:id="@+id/containerMultipleImages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvImages"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#ff1a1f2e"
            android:orientation="horizontal" />

        <!-- Indicator dots để hiển thị số lượng ảnh -->
        <LinearLayout
            android:id="@+id/indicatorDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center" />
    </LinearLayout>

    <!-- Ảnh đơn (fallback cho backward compatibility) -->
    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="6dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:background="#ff1a1f2e" />

    <!-- Video player -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:background="#ff1a1f2e">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnPlayVideo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_media_play"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#ffffff"
            android:contentDescription="Phát video"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Số lượng like/comment (clickable) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvLikesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❤ 0"
            android:textSize="13sp"
            android:textColor="#99ffffff"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/tvCounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💬 0"
            android:textSize="13sp"
            android:textColor="#99ffffff" />


    </LinearLayout>

    <!-- Thanh hành động -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#ffffff"
        android:alpha="0.15"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <!-- Nút like -->
        <LinearLayout
            android:id="@+id/btnLike"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iconLike"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_favorite_border"
                android:tint="#99ffffff" />

            <TextView
                android:id="@+id/tvLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thích"
                android:textSize="14sp"
                android:textColor="#99ffffff"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Nút comment -->
        <LinearLayout
            android:id="@+id/btnComment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iconComment"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_comment"
                app:tint="#99ffffff" />

            <TextView
                android:id="@+id/tvComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bình luận"
                android:textSize="14sp"
                android:textColor="#99ffffff"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>