<?xml version="1.0" encoding="utf-8"?>
<!-- Layout cho mỗi notification item trong RecyclerView - Design đẹp và hiện đại -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notification_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#ff2a3142"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp">

        <!-- Chấm tròn chỉ báo chưa đọc -->
        <View
            android:id="@+id/unread_indicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:visibility="gone"
            android:background="@drawable/circle_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!-- Icon container với background gradient đẹp -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/icon_container"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            app:cardCornerRadius="26dp"
            app:cardBackgroundColor="#304d9df2"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toEndOf="@id/unread_indicator"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/notification_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notifications"
                android:tint="#4d9df2"
                android:contentDescription="Notification icon" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Badge AI -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ai_badge_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="#FF6B9DF2"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="@id/icon_container"
            app:layout_constraintEnd_toEndOf="@id/icon_container"
            app:layout_constraintBottom_toBottomOf="@id/icon_container"
            tools:visibility="visible">

            <TextView
                android:id="@+id/ai_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ AI"
                android:textSize="9sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:gravity="center" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Container cho nội dung text -->
        <LinearLayout
            android:id="@+id/notification_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/icon_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/icon_container">

            <!-- Tên người gửi (nhân vật tượng trưng) -->
            <TextView
                android:id="@+id/notification_sender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#4d9df2"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:visibility="gone"
                tools:text="Zues 🦥"
                tools:visibility="visible" />

            <!-- Tiêu đề thông báo -->
            <TextView
                android:id="@+id/notification_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                tools:text="Sắp đến giờ tập!" />

            <!-- Nội dung thông báo -->
            <TextView
                android:id="@+id/notification_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:textColor="#CCFFFFFF"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                tools:text="Còn 15 phút nữa là đến giờ tập luyện vào Thứ hai. Hãy chuẩn bị sẵn sàng!" />

            <!-- Thời gian gửi thông báo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕐"
                    android:textSize="11sp"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/notification_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#99FFFFFF"
                    android:textStyle="normal"
                    tools:text="5 phút trước" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>