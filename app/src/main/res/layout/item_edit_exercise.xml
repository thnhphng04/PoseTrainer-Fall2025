<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#26FFFFFF"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Order Number -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/orderNumberCard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@color/orange"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/orderNumberTxt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Exercise Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/pic"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toEndOf="@id/orderNumberCard"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/Style.App.circleImageView"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <!-- Title -->
        <TextView
            android:id="@+id/titleTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Push Up"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/pic"
            app:layout_constraintEnd_toStartOf="@id/removeBtn"
            app:layout_constraintTop_toTopOf="@id/pic" />

        <!-- Difficulty Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/difficultyCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/orange"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="@id/titleTxt"
            app:layout_constraintTop_toBottomOf="@id/titleTxt">

            <TextView
                android:id="@+id/difficultyBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="BEGINNER"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sets & Reps -->
        <LinearLayout
            android:id="@+id/setsRepsLayout"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/titleTxt"
            app:layout_constraintEnd_toStartOf="@id/removeBtn"
            app:layout_constraintTop_toBottomOf="@id/difficultyCard">

            <!-- Sets -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/sets_reps_background"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/setsMinusBtn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_minus"
                    android:tint="@color/orange"/>

                <EditText
                    android:id="@+id/setsTxt"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:text="3"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@android:color/transparent"
                    android:inputType="number"
                    android:maxLength="2"
                    android:padding="0dp"
                    android:selectAllOnFocus="true"
                    android:imeOptions="actionNext"/>

                <ImageButton
                    android:id="@+id/setsPlusBtn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_plus"
                    android:tint="@color/orange"/>
            </LinearLayout>

            <!-- Reps -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/sets_reps_background"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/repsMinusBtn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_minus"
                    android:tint="@color/orange"/>

                <EditText
                    android:id="@+id/repsTxt"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:text="12"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@android:color/transparent"
                    android:inputType="number"
                    android:maxLength="2"
                    android:padding="0dp"
                    android:selectAllOnFocus="true"
                    android:imeOptions="actionDone"/>

                <ImageButton
                    android:id="@+id/repsPlusBtn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_plus"
                    android:tint="@color/orange"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Rest Duration -->
        <TextView
            android:id="@+id/durationTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="⏱ 30s rest"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@id/setsRepsLayout"
            app:layout_constraintTop_toBottomOf="@id/setsRepsLayout" />

        <!-- Remove Button -->
        <ImageButton
            android:id="@+id/removeBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="#FF6B6B"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
