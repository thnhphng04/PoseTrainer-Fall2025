<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:elevation="4dp"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="#20FFFFFF"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Order Number -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/orderNumberCard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:elevation="0dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/orange"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/orderNumberTxt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Exercise Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/pic"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toEndOf="@id/orderNumberCard"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/Style.App.circleImageView"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <!-- Title -->
        <TextView
            android:id="@+id/titleTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Title"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/pic"
            app:layout_constraintEnd_toStartOf="@id/difficultyCard"
            app:layout_constraintTop_toTopOf="@id/pic" />

        <!-- Difficulty Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/difficultyCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:elevation="0dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/orange"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toStartOf="@id/removeBtn"
            app:layout_constraintTop_toTopOf="@id/titleTxt">

            <TextView
                android:id="@+id/difficultyBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Beginner"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sets & Reps -->
        <LinearLayout
            android:id="@+id/setsRepsLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="@id/titleTxt"
            app:layout_constraintEnd_toStartOf="@id/removeBtn"
            app:layout_constraintTop_toBottomOf="@id/titleTxt">

            <!-- Sets -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/edit_text_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S:"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginEnd="4dp"/>

                <ImageButton
                    android:id="@+id/setsMinusBtn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_minus"
                    android:tint="@color/orange"
                    android:padding="0dp"/>

                <TextView
                    android:id="@+id/setsTxt"
                    android:layout_width="26dp"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <ImageButton
                    android:id="@+id/setsPlusBtn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_plus"
                    android:tint="@color/orange"
                    android:padding="0dp"/>
            </LinearLayout>

            <!-- Reps -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/edit_text_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R:"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginEnd="4dp"/>

                <ImageButton
                    android:id="@+id/repsMinusBtn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_minus"
                    android:tint="@color/orange"
                    android:padding="0dp"/>

                <TextView
                    android:id="@+id/repsTxt"
                    android:layout_width="26dp"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <ImageButton
                    android:id="@+id/repsPlusBtn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_plus"
                    android:tint="@color/orange"
                    android:padding="0dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Rest Duration -->
        <TextView
            android:id="@+id/durationTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="30s rest"
            android:textColor="#B3FFFFFF"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="@id/setsRepsLayout"
            app:layout_constraintTop_toBottomOf="@id/setsRepsLayout" />

        <!-- Remove Button -->
        <ImageButton
            android:id="@+id/removeBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Xóa bài tập"
            android:tint="#FF6B6B"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
